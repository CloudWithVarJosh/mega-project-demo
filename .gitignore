```gitignore
# macOS system files
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100/
.Trashes/
.fseventsd/
.VolumeIcon.icns

# Java / Maven
**/target/
*.class

# Node.js / React
**/node_modules/
**/dist/
**/build/
**/.next/
**/coverage/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment variables and local secrets
.env
.env.*
!.env.example
!.env.*.example
dev-backend-db-secret.yaml
prod-backend-db-secret.yaml

# Logs and temporary files
*.log
*.tmp
*.swp
*~

# IDE configuration
.idea/
*.iml
.vscode/
```
